@model IEnumerable<VisionQuestMvc.Models.Recuerdo>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TituloRecuerdo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TipoRecuerdo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Claridad)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.SintezoideId)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TituloRecuerdo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TipoRecuerdo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Claridad)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SintezoideId)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Details", "Details", new { id=item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
